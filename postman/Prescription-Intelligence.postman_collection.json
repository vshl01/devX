{
  "info": {
    "name": "Prescription Intelligence",
    "_postman_id": "prescription-intelligence-api",
    "description": "API collection for testing Prescription Intelligence endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Prescription Intelligence",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Upload Prescription",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "targetLanguage",
                  "value": "kn-IN",
                  "type": "text",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "prescriptions"]
            }
          }
        },
        {
          "name": "Get Prescription",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "prescriptions", "{{prescriptionId}}"]
            }
          }
        },
        {
          "name": "Get Prescription File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/file",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "prescriptions", "{{prescriptionId}}", "file"]
            }
          }
        },
        {
          "name": "Get Raw Digitised Content",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/raw",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "prescriptions", "{{prescriptionId}}", "raw"]
            }
          }
        },
        {
          "name": "Translate Prescription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetLanguage\": \"kn-IN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/translate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "prescriptions", "{{prescriptionId}}", "translate"]
            }
          }
        },
        {
          "name": "Ask Prescription Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What was my blood pressure?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/questions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "prescriptions", "{{prescriptionId}}", "questions"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "prescriptionId",
      "value": ""
    }
  ]
}
